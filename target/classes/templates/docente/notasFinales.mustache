<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cargar Notas Finales</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { font-family: 'Segoe UI', sans-serif; background-color: #f1f5f9; }
    </style>
</head>
<body class="min-h-screen bg-slate-100">

    <!-- NAVBAR -->
    <nav class="bg-white border-b border-slate-200 shadow-sm px-6 py-4 flex items-center justify-between">
        <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414A1 1 0 0119 9.414V19a2 2 0 01-2 2z"/>
                </svg>
            </div>
            <span class="font-semibold text-slate-800 text-lg">SGA &mdash; Docente</span>
        </div>
        <a href="/dashboard"
           class="text-sm text-slate-500 hover:text-slate-800 flex items-center gap-1 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            Dashboard
        </a>
    </nav>

    <div class="max-w-5xl mx-auto px-4 py-10">

        <!-- HEADER -->
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-slate-800">Cargar Notas Finales</h1>
            <p class="text-slate-500 mt-1">Seleccioná un examen y registrá los resultados de tus alumnos.</p>
        </div>

        <!-- ALERTS -->
        {{#successMessage}}
        <div class="mb-6 flex items-start gap-3 bg-green-50 border border-green-200 text-green-800 rounded-xl px-5 py-4">
            <svg class="w-5 h-5 mt-0.5 shrink-0 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            <span class="text-sm font-medium">{{successMessage}}</span>
        </div>
        {{/successMessage}}

        {{#errorMessage}}
        <div class="mb-6 flex items-start gap-3 bg-red-50 border border-red-200 text-red-800 rounded-xl px-5 py-4">
            <svg class="w-5 h-5 mt-0.5 shrink-0 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
            <span class="text-sm font-medium">{{errorMessage}}</span>
        </div>
        {{/errorMessage}}

        <!-- FILTRO: SELECCIONAR EXAMEN -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 mb-8">
            <h2 class="text-base font-semibold text-slate-700 mb-4">Seleccioná un examen</h2>

            {{#sinExamenes}}
            <div class="text-center py-8 text-slate-400">
                <svg class="w-12 h-12 mx-auto mb-3 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                        d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                </svg>
                <p class="font-medium text-slate-500">No tenés exámenes creados todavía.</p>
                <a href="/docente/examenes/crear"
                   class="inline-block mt-3 text-sm text-blue-600 hover:underline">Crear un examen</a>
            </div>
            {{/sinExamenes}}

            {{^sinExamenes}}
            <form method="GET" action="/docente/notas" class="flex flex-col sm:flex-row gap-3">
                <select name="id_examen"
                        class="flex-1 rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                    <option value="">-- Seleccioná un examen --</option>
                    {{#examenes}}
                    <option value="{{idExamen}}" {{#seleccionado}}selected{{/seleccionado}}>
                        {{nombreMateria}} &mdash; {{fecha}}
                    </option>
                    {{/examenes}}
                </select>
                <button type="submit"
                        class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-6 py-2.5 rounded-xl transition-colors shadow-sm">
                    Ver alumnos
                </button>
            </form>
            {{/sinExamenes}}
        </div>

        <!-- TABLA DE ALUMNOS -->
        {{#examenSeleccionado}}
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">

            <!-- Header tabla -->
            <div class="px-6 py-5 border-b border-slate-100 flex items-center justify-between">
                <div>
                    <h2 class="text-base font-semibold text-slate-800">
                        {{nombreMateriaSeleccionada}}
                        <span class="text-slate-400 font-normal">&mdash; {{fechaExamen}}</span>
                    </h2>
                    <p class="text-xs text-slate-400 mt-0.5">
                        {{totalAlumnos}} alumno(s) inscripto(s)
                    </p>
                </div>
            </div>

            {{#sinAlumnos}}
            <div class="text-center py-16 text-slate-400">
                <svg class="w-12 h-12 mx-auto mb-3 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                        d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                <p class="font-medium text-slate-500">No hay alumnos inscriptos a este examen.</p>
            </div>
            {{/sinAlumnos}}

            {{^sinAlumnos}}
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="bg-slate-50 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">
                            <th class="px-6 py-3">Alumno</th>
                            <th class="px-6 py-3">DNI</th>
                            <th class="px-6 py-3">Legajo</th>
                            <th class="px-6 py-3">Estado actual</th>
                            <th class="px-6 py-3 text-center">Cargar resultado</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        {{#alumnos}}
                        <tr class="hover:bg-slate-50 transition-colors">

                            <!-- Nombre -->
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center font-semibold text-xs shrink-0">
                                        {{iniciales}}
                                    </div>
                                    <div>
                                        <p class="font-medium text-slate-800">{{apellido}}, {{nombre}}</p>
                                        <p class="text-xs text-slate-400">{{email}}</p>
                                    </div>
                                </div>
                            </td>

                            <!-- DNI -->
                            <td class="px-6 py-4 text-slate-600">{{dni}}</td>

                            <!-- Legajo -->
                            <td class="px-6 py-4 text-slate-600">{{nroLegajo}}</td>

                            <!-- Estado actual -->
                            <td class="px-6 py-4">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold {{estadoClass}}">
                                    {{estadoActual}}
                                </span>
                            </td>

                            <!-- Formulario de nota -->
                            <td class="px-6 py-4">
                                {{#yaCalificado}}
                                <div class="flex items-center justify-center gap-2 text-green-600">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                    </svg>
                                    <span class="text-xs font-semibold">Resultado cargado</span>
                                </div>
                                {{/yaCalificado}}

                                {{^yaCalificado}}
                                <form method="POST" action="/docente/notas/cargar" class="flex items-center justify-center gap-2">
                                    <input type="hidden" name="id_examen"     value="{{idExamen}}"/>
                                    <input type="hidden" name="dni_estudiante" value="{{dni}}"/>
                                    <input type="hidden" name="cod_materia"    value="{{codMateria}}"/>
                                    <input
                                        type="text"
                                        name="nota_final"
                                        placeholder="Nota"
                                        class="w-20 rounded-lg border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs">
                                    <select name="resultado"
                                            class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500">
                                        <option value="">-- Resultado --</option>
                                        <option value="APROBADO">Aprobado</option>
                                        <option value="DESAPROBADO">Desaprobado</option>
                                    </select>

                                    <button type="submit"
                                            class="bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold px-3 py-1.5 rounded-lg transition-colors">
                                        Guardar
                                    </button>
                                </form>
                                {{/yaCalificado}}
                            </td>
                        </tr>
                        {{/alumnos}}
                    </tbody>
                </table>
            </div>
            {{/sinAlumnos}}
        </div>
        {{/examenSeleccionado}}

    </div>
</body>
</html>