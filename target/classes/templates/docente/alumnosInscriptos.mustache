<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alumnos Inscriptos</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen p-8">

    <!-- Header -->
    <div class="flex items-start justify-between mb-6">
        <div>
            <h1 class="text-4xl font-bold text-purple-600">Alumnos Inscriptos</h1>
            <p class="text-gray-500 mt-1">Consultá los alumnos inscriptos a tus materias.</p>
        </div>
        <a href="/dashboard"
           class="bg-gray-800 text-white px-4 py-2 rounded-lg hover:bg-gray-700 transition font-semibold">
            Volver
        </a>
    </div>

    {{#successMessage}}
    <div class="bg-green-100 border border-green-300 text-green-800 rounded-lg px-4 py-3 mb-4">
        {{successMessage}}
    </div>
    {{/successMessage}}

    {{#errorMessage}}
    <div class="bg-red-100 border border-red-300 text-red-800 rounded-lg px-4 py-3 mb-4">
        {{errorMessage}}
    </div>
    {{/errorMessage}}

    {{#sinMaterias}}
    <div class="bg-white rounded-2xl shadow-sm p-10 text-center">
        <p class="text-gray-400 text-lg">No tenés materias asignadas.</p>
    </div>
    {{/sinMaterias}}

    {{^sinMaterias}}
    <!-- Filtros -->
    <div class="bg-white rounded-2xl shadow-sm p-6 mb-6">
        <h2 class="text-lg font-bold text-gray-700 mb-4">Filtros</h2>
        <form method="get" action="/docente/alumnos" class="flex flex-wrap gap-4 items-end">

            <div>
                <label class="block text-sm font-semibold text-gray-600 mb-1">Materia</label>
                <select name="cod_materia" required
                        class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-purple-400">
                    <option value="">Seleccionar materia...</option>
                    {{#materias}}
                    <option value="{{codMateria}}">{{nombre}}</option>
                    {{/materias}}
                </select>
            </div>

            <div>
                <label class="block text-sm font-semibold text-gray-600 mb-1">Período (año)</label>
                <select name="fecha"
                        class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-purple-400">
                    <option value="">Todos los períodos</option>
                    {{#fechas}}
                    <option value="{{fecha}}">{{fecha}}</option>
                    {{/fechas}}
                </select>
            </div>

            <button type="submit"
                    class="bg-purple-500 text-white px-5 py-2 rounded-lg hover:bg-purple-600 transition font-semibold text-sm">
                Buscar
            </button>

        </form>
    </div>

    <!-- Tabla -->
    {{#mostrarTabla}}
    <div class="bg-white rounded-2xl shadow-sm p-6">
        <h2 class="text-lg font-bold text-gray-700 mb-4">Listado de Alumnos</h2>

        {{#sinAlumnos}}
        <p class="text-gray-400 text-center py-8">No hay alumnos inscriptos en esta materia.</p>
        {{/sinAlumnos}}

        {{^sinAlumnos}}
        <table class="w-full text-sm text-center">
            <thead>
                <tr class="border-b border-gray-200 text-gray-600 font-semibold">
                    <th class="py-3 px-4">Legajo</th>
                    <th class="py-3 px-4">Apellido</th>
                    <th class="py-3 px-4">Nombre</th>
                    <th class="py-3 px-4">DNI</th>
                    <th class="py-3 px-4">Email</th>
                    <th class="py-3 px-4">Estado</th>
                </tr>
            </thead>
            <tbody>
                {{#alumnos}}
                <tr class="border-b border-gray-100 hover:bg-gray-50 transition">
                    <td class="py-3 px-4 text-gray-600">{{nroLegajo}}</td>
                    <td class="py-3 px-4 font-medium text-gray-800">{{apellido}}</td>
                    <td class="py-3 px-4 text-gray-700">{{nombre}}</td>
                    <td class="py-3 px-4 text-gray-600">{{dni}}</td>
                    <td class="py-3 px-4 text-gray-600">{{email}}</td>
                    <<td class="py-3 px-4">
                    {{^esInscripto}}
                    <span class="px-3 py-1 rounded-full text-xs font-semibold {{estadoClass}}">
                        {{estado}}
                    </span>
                    {{/esInscripto}}

                    {{#esInscripto}}
                    <form method="POST" action="/docente/alumnos/estadoCursada" class="flex items-center justify-center gap-2">
                        <input type="hidden" name="dni_estudiante" value="{{dni}}"/>
                        <input type="hidden" name="cod_materia"    value="{{codMateria}}"/>
                        <select name="nuevo_estado"
                                class="border border-gray-300 rounded-lg px-2 py-1 text-xs focus:outline-none focus:ring-2 focus:ring-purple-400">
                            <option value="REGULAR">Regular</option>
                            <option value="LIBRE">Libre</option>
                        </select>
                        <button type="submit"
                                class="bg-purple-500 hover:bg-purple-600 text-white text-xs font-semibold px-3 py-1 rounded-lg transition">
                            Guardar
                        </button>
                    </form>
                    {{/esInscripto}}
                </td>
                </tr>
                {{/alumnos}}
            </tbody>
        </table>
        {{/sinAlumnos}}
    </div>
    {{/mostrarTabla}}
    {{/sinMaterias}}

</body>
</html>