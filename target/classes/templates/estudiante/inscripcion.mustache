<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inscripción a Materias</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen p-6">

<div class="max-w-5xl mx-auto">

    <!-- HEADER -->
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-3xl font-bold text-blue-700">Inscripción a Materias</h1>
            <p class="text-gray-600 mt-1">
                {{nombre}} {{apellido}} — Legajo <span class="font-semibold">{{nroLegajo}}</span>
            </p>
        </div>
        <a href="/estudiante/dashboard"
           class="bg-gray-700 text-white px-5 py-2 rounded-lg hover:bg-gray-800 transition">
            Volver
        </a>
    </div>

    <!-- MENSAJES -->
    {{#successMessage}}
    <div class="bg-green-100 border border-green-300 text-green-800 p-4 rounded mb-6">
        ✓ {{successMessage}}
    </div>
    {{/successMessage}}

    {{#errorMessage}}
    <div class="bg-red-100 border border-red-300 text-red-800 p-4 rounded mb-6">
        ✗ {{errorMessage}}
    </div>
    {{/errorMessage}}

    <!-- MATERIAS DISPONIBLES -->
    <div class="bg-white rounded-2xl shadow-md border border-gray-200 p-6 mb-8">
        <h2 class="text-xl font-bold text-gray-800 mb-2">Materias disponibles para inscripción</h2>
        <p class="text-sm text-gray-500 mb-5">
            Solo se muestran materias con período académico activo. Las correlatividades requeridas deben estar <strong>aprobadas</strong>.
        </p>

        {{#sinMaterias}}
        <div class="text-center py-8 text-gray-400">
            <p class="text-lg">No hay materias disponibles en este momento.</p>
            <p class="text-sm mt-1">Consultá con el administrador si esperabas ver materias aquí.</p>
        </div>
        {{/sinMaterias}}

        {{^sinMaterias}}
        <div class="overflow-x-auto">
            <table class="min-w-full border border-gray-200">
                <thead class="bg-gray-100">
                    <tr>
                        <th class="p-3 border text-left">Código</th>
                        <th class="p-3 border text-left">Materia</th>
                        <th class="p-3 border text-left">Descripción</th>
                        <th class="p-3 border text-left">Correlativas requeridas</th>
                        <th class="p-3 border text-center">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    {{#materias}}
                    <tr class="hover:bg-gray-50">
                        <td class="p-3 border text-center font-mono text-sm">{{codMateria}}</td>
                        <td class="p-3 border font-medium">{{nombre}}</td>
                        <td class="p-3 border text-gray-600 text-sm">{{descripcion}}</td>
                        <td class="p-3 border text-sm">
                            {{^tieneCorrelativas}}
                            <span class="text-gray-400 italic">Sin correlativas</span>
                            {{/tieneCorrelativas}}
                            {{#tieneCorrelativas}}
                            {{#puedeInscribirse}}
                            <span class="text-green-600">✓ Cumplidas</span>
                            {{/puedeInscribirse}}
                            {{^puedeInscribirse}}
                            <span class="text-red-600">✗ Falta aprobar:<br>
                                <span class="font-semibold">{{correlativasFaltantes}}</span>
                            </span>
                            {{/puedeInscribirse}}
                            {{/tieneCorrelativas}}
                        </td>
                        <td class="p-3 border text-center">
                            {{#puedeInscribirse}}
                            <form method="POST" action="/estudiante/inscripcion">
                                <input type="hidden" name="cod_materia" value="{{codMateria}}">
                                <button type="submit"
                                        class="bg-blue-600 text-white px-4 py-1.5 rounded hover:bg-blue-700 transition text-sm font-semibold">
                                    Inscribirme
                                </button>
                            </form>
                            {{/puedeInscribirse}}
                            {{^puedeInscribirse}}
                            <span class="text-gray-400 text-sm italic">No habilitada</span>
                            {{/puedeInscribirse}}
                        </td>
                    </tr>
                    {{/materias}}
                </tbody>
            </table>
        </div>
        {{/sinMaterias}}
    </div>

    <!-- MIS INSCRIPCIONES -->
    {{#tieneInscriptas}}
    <div class="bg-white rounded-2xl shadow-md border border-gray-200 p-6">
        <h2 class="text-xl font-bold text-gray-800 mb-4">Mis inscripciones</h2>
        <div class="overflow-x-auto">
            <table class="min-w-full border border-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="p-3 border text-left">Código</th>
                        <th class="p-3 border text-left">Materia</th>
                        <th class="p-3 border text-center">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    {{#inscriptas}}
                    <tr class="hover:bg-gray-50">
                        <td class="p-3 border text-center font-mono text-sm">{{codMateria}}</td>
                        <td class="p-3 border font-medium">{{nombre}}</td>
                        <td class="p-3 border text-center">
                            <span class="px-2 py-1 rounded-full text-xs font-semibold
                                {{#estado}}
                                {{/estado}}
                                bg-blue-100 text-blue-700">
                                {{estado}}
                            </span>
                        </td>
                    </tr>
                    {{/inscriptas}}
                </tbody>
            </table>
        </div>
    </div>
    {{/tieneInscriptas}}

</div>
</body>
</html>