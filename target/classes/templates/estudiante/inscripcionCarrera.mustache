<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inscripción a Carrera</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen p-6">

<div class="max-w-4xl mx-auto">

    <!-- HEADER -->
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-3xl font-bold text-indigo-700">Inscripción a Carrera</h1>
            <p class="text-gray-600 mt-1">
                {{nombre}} {{apellido}} — Legajo <span class="font-semibold">{{nroLegajo}}</span>
            </p>
        </div>
        <a href="/estudiante/dashboard"
           class="bg-gray-700 text-white px-5 py-2 rounded-lg hover:bg-gray-800 transition">
            Volver
        </a>
    </div>

    <!-- MENSAJES -->
    {{#successMessage}}
    <div class="bg-green-100 border border-green-300 text-green-800 p-4 rounded mb-6">
        ✓ {{successMessage}}
    </div>
    {{/successMessage}}

    {{#errorMessage}}
    <div class="bg-red-100 border border-red-300 text-red-800 p-4 rounded mb-6">
        ✗ {{errorMessage}}
    </div>
    {{/errorMessage}}

    <!-- YA INSCRIPTO: mostrar carrera y estado en la cursada -->
    {{#yaInscripto}}
    <div class="bg-white rounded-2xl shadow-md border border-indigo-200 p-6 mb-6">
        <h2 class="text-xl font-bold text-gray-800 mb-4">Tu inscripción a carrera</h2>

        <div class="flex items-start gap-4">
            <div class="flex-1 bg-indigo-50 rounded-xl p-5">
                <p class="text-lg font-semibold text-indigo-800">{{carreraActual}}</p>
                {{#descripcionActual}}
                <p class="text-sm text-gray-500 mt-1">{{descripcionActual}}</p>
                {{/descripcionActual}}
            </div>

            <div class="flex flex-col items-center gap-2 min-w-fit">
                <span class="text-xs text-gray-400 uppercase tracking-wider">Estado en cursada</span>
                {{#esIngresante}}
                <span class="bg-yellow-100 text-yellow-700 border border-yellow-300 px-4 py-2 rounded-lg text-sm font-semibold">
                    📚 Ingresante
                </span>
                {{/esIngresante}}
                {{#esAvanzado}}
                <span class="bg-green-100 text-green-700 border border-green-300 px-4 py-2 rounded-lg text-sm font-semibold">
                    🎓 Avanzado
                </span>
                {{/esAvanzado}}
            </div>
        </div>

        <p class="text-xs text-gray-400 mt-4">
            Para cambiar de carrera o actualizar tu estado, contactá al administrador.
        </p>
    </div>
    {{/yaInscripto}}

    <!-- NO INSCRIPTO: listar carreras disponibles -->
    {{^yaInscripto}}
    <div class="bg-white rounded-2xl shadow-md border border-gray-200 p-6">
        <h2 class="text-xl font-bold text-gray-800 mb-2">Carreras disponibles</h2>
        <p class="text-sm text-gray-500 mb-5">
            Seleccioná la carrera a la que querés inscribirte. Tu estado inicial será <strong>Ingresante</strong>.
            El cambio de estado a Avanzado es gestionado por el administrador.
        </p>

        {{#sinCarreras}}
        <div class="text-center py-10 text-gray-400">
            <p class="text-lg">No hay carreras disponibles en este momento.</p>
            <p class="text-sm mt-1">Consultá con el administrador.</p>
        </div>
        {{/sinCarreras}}

        {{^sinCarreras}}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {{#carreras}}
            <div class="border border-gray-200 rounded-xl p-5 hover:border-indigo-400 hover:shadow-sm transition">
                <h3 class="text-lg font-semibold text-gray-800">{{nombre}}</h3>
                {{#descripcion}}
                <p class="text-sm text-gray-500 mt-1 mb-4">{{descripcion}}</p>
                {{/descripcion}}
                {{^descripcion}}
                <p class="text-sm text-gray-400 mt-1 mb-4 italic">Sin descripción</p>
                {{/descripcion}}
                <form method="POST" action="/estudiante/carrera/inscribir">
                    <input type="hidden" name="cod_carrera" value="{{codCarrera}}">
                    <button type="submit"
                            class="bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700 transition text-sm font-semibold w-full">
                        Inscribirme
                    </button>
                </form>
            </div>
            {{/carreras}}
        </div>
        {{/sinCarreras}}
    </div>
    {{/yaInscripto}}

</div>
</body>
</html>