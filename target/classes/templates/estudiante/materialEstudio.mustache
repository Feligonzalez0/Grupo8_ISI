<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Material de Estudio</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen p-8">

    <div class="flex items-start justify-between mb-6">
        <div>
            <h1 class="text-4xl font-bold text-purple-600">Material de Estudio</h1>
            <p class="text-gray-500 mt-1">Material disponible para tus materias.</p>
        </div>
        <a href="/dashboard"
           class="bg-gray-800 text-white px-4 py-2 rounded-lg hover:bg-gray-700 transition font-semibold">
            Volver
        </a>
    </div>

    <div class="bg-white rounded-2xl shadow-sm p-6">

        {{#sinMateriales}}
        <p class="text-gray-400 text-center py-8">No hay material disponible para tus materias todavía.</p>
        {{/sinMateriales}}

        {{^sinMateriales}}
        <table class="w-full text-sm text-center">
            <thead>
                <tr class="border-b border-gray-200 text-gray-600 font-semibold">
                    <th class="py-3 px-4 text-left">Título</th>
                    <th class="py-3 px-4 text-left">Materia</th>
                    <th class="py-3 px-4 text-left">Descripción</th>
                    <th class="py-3 px-4">Fecha</th>
                    <th class="py-3 px-4">Acción</th>
                </tr>
            </thead>
            <tbody>
                {{#materiales}}
                <tr class="border-b border-gray-100 hover:bg-gray-50 transition">
                    <td class="py-3 px-4 text-left font-medium text-gray-800">{{nombre}}</td>
                    <td class="py-3 px-4 text-left text-gray-600">{{nombreMateria}}</td>
                    <td class="py-3 px-4 text-left text-gray-500 text-xs">{{descripcion}}</td>
                    <td class="py-3 px-4 text-gray-600">{{fechaSubida}}</td>
                    <td class="py-3 px-4">
                        <a href="/material/descargar/{{id}}"
                           class="bg-blue-500 text-white px-3 py-1 rounded-lg hover:bg-blue-600 transition text-xs font-semibold">
                            Descargar
                        </a>
                    </td>
                </tr>
                {{/materiales}}
            </tbody>
        </table>
        {{/sinMateriales}}
    </div>

</body>
</html>