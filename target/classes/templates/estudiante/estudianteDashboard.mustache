<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel del Estudiante</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 min-h-screen p-6">

    <div class="max-w-7xl mx-auto">

        <div class="flex justify-between items-center mb-8">
            <div>
                <h1 class="text-4xl font-bold text-gray-800">
                    Mi Panel
                </h1>
                <p class="text-gray-600 mt-2">
                    Bienvenido/a, <span class="font-semibold">{{nombre}} {{apellido}}</span>
                    — Legajo <span class="font-semibold">{{nroLegajo}}</span>
                </p>
            </div>

            <a href="/dashboard"
               class="bg-gray-700 text-white px-5 py-2 rounded-lg hover:bg-gray-800 transition">
                Volver
            </a>
        </div>

        {{#errorMessage}}
        <div class="bg-red-100 border border-red-300 text-red-800 p-4 rounded mb-6">
            {{errorMessage}}
        </div>
        {{/errorMessage}}

        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">

            <!-- Inscripción a Materias -->
            <div class="bg-white rounded-2xl shadow-md border border-gray-200 p-6">
                <h2 class="text-2xl font-bold text-blue-700 mb-3">
                    Inscripción a Materias
                </h2>
                <p class="text-gray-600 mb-5">
                    Consultá las materias disponibles e inscribite en las que cumplís las correlatividades.
                </p>
                <a href="/estudiante/inscripcion"
                   class="inline-block bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition">
                    Ver materias
                </a>
            </div>

            <!-- Exámenes Finales -->
            <div class="bg-white rounded-2xl shadow-md border border-gray-200 p-6">
                <h2 class="text-2xl font-bold text-green-700 mb-3">
                    Exámenes Finales
                </h2>
                <p class="text-gray-600 mb-5">
                    Consultá los exámenes finales disponibles e inscribite para rendir.
                </p>
                <a href="/estudiante/examenes"
                   class="inline-block bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 transition">
                    Ver exámenes
                </a>
            </div>

            <!-- Inscripción a Carrera -->
            <div class="bg-white rounded-2xl shadow-md border border-gray-200 p-6">
                <h2 class="text-2xl font-bold text-indigo-700 mb-3">
                    Inscripción a Carreras
                </h2>
                <p class="text-gray-600 mb-5">
                    Inscribite a una carrera disponible o consultá en cuál estás anotado.
                </p>
                <a href="/estudiante/carrera"
                   class="inline-block bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700 transition">
                    Ver carreras
                </a>
            </div>

        </div>

    </div>

</body>
</html>
