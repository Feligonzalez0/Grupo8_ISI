<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Material de Estudio</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen p-8">

    <div class="flex items-start justify-between mb-6">
        <div>
            <h1 class="text-4xl font-bold text-purple-600">Material de Estudio</h1>
            <p class="text-gray-500 mt-1">Subí material teórico y práctico para tus materias.</p>
        </div>
        <a href="/dashboard"
           class="bg-gray-800 text-white px-4 py-2 rounded-lg hover:bg-gray-700 transition font-semibold">
            Volver
        </a>
    </div>

    {{#successMessage}}
    <div class="bg-green-100 border border-green-300 text-green-800 rounded-lg px-4 py-3 mb-4">
        {{successMessage}}
    </div>
    {{/successMessage}}
    {{#errorMessage}}
    <div class="bg-red-100 border border-red-300 text-red-800 rounded-lg px-4 py-3 mb-4">
        {{errorMessage}}
    </div>
    {{/errorMessage}}

    <!-- Formulario subida -->
    {{^sinMaterias}}
    <div class="bg-white rounded-2xl shadow-sm p-6 mb-6">
        <h2 class="text-lg font-bold text-gray-700 mb-4">Subir nuevo material</h2>
        <form action="/docente/material/subir" method="post" enctype="multipart/form-data"
              class="flex flex-col gap-4">

            <div>
                <label class="block text-sm font-semibold text-gray-600 mb-1">Título</label>
                <input type="text" name="nombre" required
                       class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-purple-400">
            </div>

            <div>
                <label class="block text-sm font-semibold text-gray-600 mb-1">Descripción</label>
                <textarea name="descripcion" rows="2"
                          class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-purple-400"></textarea>
            </div>

            <div>
                <label class="block text-sm font-semibold text-gray-600 mb-1">Materia</label>
                <select name="cod_materia" required
                        class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-purple-400">
                    <option value="">Seleccionar materia...</option>
                    {{#materias}}
                    <option value="{{codMateria}}">{{nombre}}</option>
                    {{/materias}}
                </select>
            </div>

            <div>
                <label class="block text-sm font-semibold text-gray-600 mb-1">
                    Archivo (PDF, DOC, DOCX, PPT, PPTX, XLS, XLSX, JPG, PNG)
                </label>
                <input type="file" name="archivo" required
                       accept=".pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.jpg,.png"
                       class="w-full text-sm text-gray-600">
            </div>

            <div>
                <button type="submit"
                        class="bg-purple-500 text-white px-6 py-2 rounded-lg hover:bg-purple-600 transition font-semibold text-sm">
                    Subir Material
                </button>
            </div>
        </form>
    </div>
    {{/sinMaterias}}

    <!-- Listado -->
    <div class="bg-white rounded-2xl shadow-sm p-6">
        <h2 class="text-lg font-bold text-gray-700 mb-4">Materiales subidos</h2>

        {{#sinMateriales}}
        <p class="text-gray-400 text-center py-8">No subiste materiales todavía.</p>
        {{/sinMateriales}}

        {{^sinMateriales}}
        <table class="w-full text-sm text-center">
            <thead>
                <tr class="border-b border-gray-200 text-gray-600 font-semibold">
                    <th class="py-3 px-4 text-left">Título</th>
                    <th class="py-3 px-4 text-left">Materia</th>
                    <th class="py-3 px-4 text-left">Archivo</th>
                    <th class="py-3 px-4">Fecha</th>
                    <th class="py-3 px-4">Acción</th>
                </tr>
            </thead>
            <tbody>
                {{#materiales}}
                <tr class="border-b border-gray-100 hover:bg-gray-50 transition">
                    <td class="py-3 px-4 text-left font-medium text-gray-800">{{nombre}}</td>
                    <td class="py-3 px-4 text-left text-gray-600">{{nombreMateria}}</td>
                    <td class="py-3 px-4 text-left text-gray-500 text-xs">{{nombreArchivo}}</td>
                    <td class="py-3 px-4 text-gray-600">{{fechaSubida}}</td>
                    <td class="py-3 px-4">
                        <a href="/material/descargar/{{idDescarga}}"
                           class="bg-blue-500 text-white px-3 py-1 rounded-lg hover:bg-blue-600 transition text-xs font-semibold">
                            Descargar
                        </a>
                    </td>
                </tr>
                {{/materiales}}
            </tbody>
        </table>
        {{/sinMateriales}}
    </div>

</body>
</html>