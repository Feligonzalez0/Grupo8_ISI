<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Avance Académico</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen p-8">

    <!-- Header -->
    <div class="flex items-start justify-between mb-6">
        <div>
            <h1 class="text-4xl font-bold text-purple-600">Avance Académico</h1>
            <p class="text-gray-500 mt-1">
                {{apellido}}, {{nombre}} — Legajo: {{nroLegajo}}
            </p>
        </div>
        <a href="/dashboard"
           class="bg-gray-800 text-white px-4 py-2 rounded-lg hover:bg-gray-700 transition font-semibold">
            Volver
        </a>
    </div>

    {{#sinEstados}}
    <div class="bg-white rounded-2xl shadow-sm p-10 text-center">
        <p class="text-gray-400 text-lg">No tenés materias inscriptas todavía.</p>
    </div>
    {{/sinEstados}}

    {{^sinEstados}}

    <!-- Card porcentaje -->
    <div class="bg-white rounded-2xl shadow-sm p-6 mb-6">
        <h2 class="text-lg font-bold text-gray-700 mb-4">Progreso de la Carrera</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
            <div class="bg-white rounded-2xl shadow-sm p-6 text-center border-t-4 border-green-400">
                <p class="text-4xl font-bold text-green-600">{{cantAprobadas}}</p>
                <p class="text-gray-500 text-sm mt-1">Materias aprobadas</p>
            </div>
            <div class="bg-white rounded-2xl shadow-sm p-6 text-center border-t-4 border-gray-300">
                <p class="text-4xl font-bold text-gray-600">{{totalMaterias}}</p>
                <p class="text-gray-500 text-sm mt-1">Total del plan</p>
            </div>
            <div class="bg-white rounded-2xl shadow-sm p-6 text-center border-t-4 border-purple-400">
                <p class="text-4xl font-bold text-purple-600">{{porcentaje}}%</p>
                <p class="text-gray-500 text-sm mt-1">Completado</p>
            </div>
        </div>
    </div>

    <!-- Materias aprobadas -->
    <div class="bg-white rounded-2xl shadow-sm p-6 mb-6">
        <h2 class="text-lg font-bold text-gray-700 mb-4">
            Materias Aprobadas
            <span class="bg-green-100 text-green-700 px-2 py-0.5 rounded-full text-sm font-semibold ml-2">
                {{cantAprobadas}}
            </span>
        </h2>

        {{^aprobadas}}
        <p class="text-gray-400 text-center py-4">No tenés materias aprobadas todavía.</p>
        {{/aprobadas}}

        {{#aprobadas}}
        {{#-first}}
        <table class="w-full text-sm text-center">
            <thead>
                <tr class="border-b border-gray-200 text-gray-600 font-semibold">
                    <th class="py-3 px-4 text-left">Materia</th>
                    <th class="py-3 px-4">Estado</th>
                </tr>
            </thead>
            <tbody>
        {{/-first}}
                <tr class="border-b border-gray-100 hover:bg-gray-50 transition">
                    <td class="py-3 px-4 text-left font-medium text-gray-800">{{nombre}}</td>
                    <td class="py-3 px-4">
                        <span class="px-3 py-1 rounded-full text-xs font-semibold {{estadoClass}}">
                            {{estado}}
                        </span>
                    </td>
                </tr>
        {{#-last}}
            </tbody>
        </table>
        {{/-last}}
        {{/aprobadas}}
    </div>

    <!-- Materias pendientes -->
    <div class="bg-white rounded-2xl shadow-sm p-6">
        <h2 class="text-lg font-bold text-gray-700 mb-4">Materias Pendientes</h2>

        {{^pendientes}}
        <p class="text-gray-400 text-center py-4">¡No tenés materias pendientes!</p>
        {{/pendientes}}

        {{#pendientes}}
        {{#-first}}
        <table class="w-full text-sm text-center">
            <thead>
                <tr class="border-b border-gray-200 text-gray-600 font-semibold">
                    <th class="py-3 px-4 text-left">Materia</th>
                    <th class="py-3 px-4">Estado</th>
                </tr>
            </thead>
            <tbody>
        {{/-first}}
                <tr class="border-b border-gray-100 hover:bg-gray-50 transition">
                    <td class="py-3 px-4 text-left font-medium text-gray-800">{{nombre}}</td>
                    <td class="py-3 px-4">
                        <span class="px-3 py-1 rounded-full text-xs font-semibold {{estadoClass}}">
                            {{estado}}
                        </span>
                    </td>
                </tr>
        {{#-last}}
            </tbody>
        </table>
        {{/-last}}
        {{/pendientes}}
    </div>

    {{/sinEstados}}

</body>
</html>